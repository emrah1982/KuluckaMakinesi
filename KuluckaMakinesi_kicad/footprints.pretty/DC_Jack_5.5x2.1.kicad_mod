(footprint "DC_Jack_5.5x2.1" (version 20221018) (generator pcbnew)
  (layer "F.Cu")
  (descr "DC Power Jack 5.5x2.1mm panel mount, 24V DC giris. 3-pin THT (V+/V-/switch). Center positive konvansiyonu")
  (tags "DC jack barrel 5.5 2.1 power input")
  (attr through_hole)
  (fp_text reference "J**" (at 0 -8) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value "DC_JACK_24V" (at 0 8) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15))))
  (fp_text user "${REFERENCE}" (at 0 0) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15))))

  (fp_line (start -7 -6.5) (end 7 -6.5) (layer "F.SilkS") (width 0.15))
  (fp_line (start 7 -6.5) (end 7 6.5) (layer "F.SilkS") (width 0.15))
  (fp_line (start 7 6.5) (end -7 6.5) (layer "F.SilkS") (width 0.15))
  (fp_line (start -7 6.5) (end -7 -6.5) (layer "F.SilkS") (width 0.15))

  (fp_line (start -7 -6.5) (end 7 -6.5) (layer "F.Fab") (width 0.1))
  (fp_line (start 7 -6.5) (end 7 6.5) (layer "F.Fab") (width 0.1))
  (fp_line (start 7 6.5) (end -7 6.5) (layer "F.Fab") (width 0.1))
  (fp_line (start -7 6.5) (end -7 -6.5) (layer "F.Fab") (width 0.1))

  (fp_line (start -7.5 -7) (end 7.5 -7) (layer "F.CrtYd") (width 0.05))
  (fp_line (start 7.5 -7) (end 7.5 7) (layer "F.CrtYd") (width 0.05))
  (fp_line (start 7.5 7) (end -7.5 7) (layer "F.CrtYd") (width 0.05))
  (fp_line (start -7.5 7) (end -7.5 -7) (layer "F.CrtYd") (width 0.05))

  (fp_circle (center -6 0) (end -3.25 0) (layer "F.SilkS") (width 0.15) (fill none))
  (fp_circle (center -6 0) (end -4.95 0) (layer "F.SilkS") (width 0.1) (fill none))

  (fp_text user "24V+" (at 1 -4 0) (layer "F.SilkS") (effects (font (size 0.7 0.7) (thickness 0.12))))
  (fp_text user "GND" (at 4 4.3 0) (layer "F.SilkS") (effects (font (size 0.7 0.7) (thickness 0.12))))

  (pad "1" thru_hole rect   (at 0 -3) (size 2.5 2.5) (drill 1.5) (layers *.Cu *.Mask))
  (pad "2" thru_hole circle (at 4.6 3) (size 2.5 2.5) (drill 1.5) (layers *.Cu *.Mask))
  (pad "2" thru_hole circle (at -4.6 3) (size 2.5 2.5) (drill 1.5) (layers *.Cu *.Mask))
)
