(footprint "SHT40_Cable_Module" (version 20221018) (generator pcbnew)
  (layer "F.Cu")
  (descr "SHT40 Waterproof Temp/Humidity sensor with 1m cable. 4-pin 2.54mm header for cable connection (Red=VCC3V3, Black=GND, White=SDA, Yellow=SCL)")
  (tags "SHT40 I2C temperature humidity waterproof cable")
  (attr through_hole)
  (fp_text reference "U**" (at 0 -6) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value "SHT40_CABLE" (at 0 6) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15))))
  (fp_text user "${REFERENCE}" (at 0 0) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15))))

  (fp_line (start -6.5 -4) (end 6.5 -4) (layer "F.SilkS") (width 0.12))
  (fp_line (start 6.5 -4) (end 6.5 4) (layer "F.SilkS") (width 0.12))
  (fp_line (start 6.5 4) (end -6.5 4) (layer "F.SilkS") (width 0.12))
  (fp_line (start -6.5 4) (end -6.5 -4) (layer "F.SilkS") (width 0.12))

  (fp_line (start -6.5 -4) (end 6.5 -4) (layer "F.Fab") (width 0.1))
  (fp_line (start 6.5 -4) (end 6.5 4) (layer "F.Fab") (width 0.1))
  (fp_line (start 6.5 4) (end -6.5 4) (layer "F.Fab") (width 0.1))
  (fp_line (start -6.5 4) (end -6.5 -4) (layer "F.Fab") (width 0.1))

  (fp_line (start -7 -4.5) (end 7 -4.5) (layer "F.CrtYd") (width 0.05))
  (fp_line (start 7 -4.5) (end 7 4.5) (layer "F.CrtYd") (width 0.05))
  (fp_line (start 7 4.5) (end -7 4.5) (layer "F.CrtYd") (width 0.05))
  (fp_line (start -7 4.5) (end -7 -4.5) (layer "F.CrtYd") (width 0.05))

  (fp_text user "VCC (R)"  (at -3.81 -2.5 0) (layer "F.SilkS") (effects (font (size 0.6 0.6) (thickness 0.1))))
  (fp_text user "GND (Bk)" (at -1.27 -2.5 0) (layer "F.SilkS") (effects (font (size 0.6 0.6) (thickness 0.1))))
  (fp_text user "SDA (W)"  (at  1.27 -2.5 0) (layer "F.SilkS") (effects (font (size 0.6 0.6) (thickness 0.1))))
  (fp_text user "SCL (Y)"  (at  3.81 -2.5 0) (layer "F.SilkS") (effects (font (size 0.6 0.6) (thickness 0.1))))

  (pad "1" thru_hole rect   (at -3.81 0) (size 1.7 1.7) (drill 1) (layers *.Cu *.Mask))
  (pad "2" thru_hole circle (at -1.27 0) (size 1.7 1.7) (drill 1) (layers *.Cu *.Mask))
  (pad "3" thru_hole circle (at  1.27 0) (size 1.7 1.7) (drill 1) (layers *.Cu *.Mask))
  (pad "4" thru_hole circle (at  3.81 0) (size 1.7 1.7) (drill 1) (layers *.Cu *.Mask))
)
